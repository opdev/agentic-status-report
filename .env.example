# Jira (Red Hat)
JIRA_BASE_URL=https://redhat.atlassian.net
JIRA_EMAIL=you@redhat.com
JIRA_API_TOKEN=
JIRA_PROJECTS=EET

# GitHub
GITHUB_TOKEN=
GITHUB_LOGIN=
